#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_CFLAGS_MAINT_APPEND = -DTINYCOMPRESS_PLUGIN_DIR=\"/usr/lib/${DEB_HOST_MULTIARCH}/\"

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- \
	--with-glib

override_dh_install:
	dh_install
	rm -f $(CURDIR)/debian/tmp/usr/lib/*/*.la
